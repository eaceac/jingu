TRANSPORT=bluebubbles
AI_MODE=openai
PORT=3000
DATABASE_URL=postgres://jingu:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:55440/jingu
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
OPENAI_API_KEY=
OPENAI_MODEL=
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=
# Use the EXACT handle and direct-chat GUID from BlueBubbles. Never use a group chat.
# selfChat true is ONLY for your own self-chat on the same Apple Account.
BLUEBUBBLES_LEARNERS='[{"id":"personal-learner","sender":"you@example.com","chatGuid":"iMessage;-;you@example.com","selfChat":true,"timezone":"America/Los_Angeles"}]'
JINGU_TIMEZONE=America/Los_Angeles
MAX_AI_CALLS_PER_DAY=100
MAX_GLOBAL_AI_CALLS_PER_DAY=300
# Applies to iMessage as well as SMS; per learner.
MAX_SMS_PER_DAY=60
