# Copy to .env; never commit actual secrets.
DATABASE_URL=postgres://localhost/jingu
ADMIN_TOKEN=replace-with-at-least-32-random-characters
PORT=3000
JINGU_TIMEZONE=America/Los_Angeles
# Safe offline default. Live SMS requires twilio + openai.
TRANSPORT=console
AI_MODE=fake
PUBLIC_URL=
LEARNER_PHONE=
TWILIO_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_AI_CALLS_PER_DAY=100
MAX_SMS_PER_DAY=60
