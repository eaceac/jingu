# Copy to .env; keep real credentials out of Git.
DATABASE_URL=postgres://localhost/jingu
ADMIN_TOKEN=replace-with-at-least-32-random-characters
PORT=3000
BIND_HOST=127.0.0.1
JINGU_TIMEZONE=UTC
GARDEN_NICKNAME=Gardener
# console + fake is for offline development; web + openai is for personal use.
TRANSPORT=console
AI_MODE=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# SHA-256 of a randomly generated high-entropy website password.
WEB_PASSWORD_HASH=
MAX_AI_CALLS_PER_DAY=100
MAX_GLOBAL_AI_CALLS_PER_DAY=300
MAX_REPLIES_PER_DAY=60
